# Database Connection String (PostgreSQL via Neon / Supabase or local SQLite)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Maps API Key (Distance Matrix API + Geolocation)
GOOGLE_MAPS_API_KEY=YOUR_ACTUAL_GOOGLE_MAPS_API_KEY

# Hospital Coordinates (Latitude & Longitude)
# Default: SIET Tumakuru Campus
HOSPITAL_LATITUDE=13.340881
HOSPITAL_LONGITUDE=77.100601
