# Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-placeholder.region.neon.tech/neondb?sslmode=require

# JWT Authentication Secret Key (Minimum 32 random characters recommended)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_minimum_32_characters

# SMS Notification Gateway (Fast2SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
ENABLE_REAL_SMS=False

# Transit Routing Engine (OpenRouteService / Google Maps)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Staff Admin Authentication Credentials
STAFF_DEFAULT_PASSWORD=change_this_staff_password_here
